
import crypto;

class Main
{
  static public main(argv)
  {/*{{{*/

    // - binary big-endian modulus and exponent of a 2048 bit RSA public key -
    modulus = Crypto.decode_base64("");
    exponent = Crypto.decode_base64("AQAB");

    // - RSA-SHA256 (PKCS#1 v1.5) signature of msg made with the matching private key -
    msg = "message signed for the rsa_public_from_mod_exp test";
    sig = Crypto.decode_base64("");

    if (modulus.length() != 256)
    {
      new Exception("unexpected modulus length").throw();
    }

    pub = CryptoPKey.rsa_public_from_mod_exp(modulus,exponent);

    // - verify OK with constructed public key -
    v = new CryptoDigestVerify("RSA-SHA256",pub);
    v.update(msg);
    if (v.verify(sig) != 1)
    {
      new Exception("verify with constructed key failed").throw();
    }

    // - multi-update verify over the same message -
    v2 = new CryptoDigestVerify("RSA-SHA256",pub);
    v2.update("message signed for ");
    v2.update("the rsa_public_from_mod_exp test");
    if (v2.verify(sig) != 1)
    {
      new Exception("multi-update verify with constructed key failed").throw();
    }

    // - verify fails on tampered message -
    v3 = new CryptoDigestVerify("RSA-SHA256",pub);
    v3.update(msg + "x");
    if (v3.verify(sig) == 1)
    {
      new Exception("verify with tampered message unexpectedly succeeded").throw();
    }
  }/*}}}*/
}
