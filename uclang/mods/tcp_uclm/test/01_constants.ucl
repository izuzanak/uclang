
import sys;
import tcp;

class Main
{
  static public main(argv)
  {/*{{{*/

    // - server event type constants -
    if (TcpServer.EVENT_ACCEPTED != 0)
    {
      new Exception("EVENT_ACCEPTED: expected 0, got %s" % $TcpServer.EVENT_ACCEPTED).throw();
    }

    if (TcpServer.EVENT_DROPPED != 2)
    {
      new Exception("EVENT_DROPPED: expected 2, got %s" % $TcpServer.EVENT_DROPPED).throw();
    }

    // - server connection index constants -
    if (TcpServer.CONN_ALL != -1)
    {
      new Exception("CONN_ALL: expected -1, got %s" % $TcpServer.CONN_ALL).throw();
    }

    // - client event type constants -
    if (TcpClient.EVENT_ERROR != -1)
    {
      new Exception("EVENT_ERROR: expected -1, got %s" % $TcpClient.EVENT_ERROR).throw();
    }

    if (TcpClient.EVENT_CONNECTED != 1)
    {
      new Exception("EVENT_CONNECTED: expected 1, got %s" % $TcpClient.EVENT_CONNECTED).throw();
    }

    if (TcpClient.EVENT_DROPPED != 2)
    {
      new Exception("EVENT_DROPPED: expected 2, got %s" % $TcpClient.EVENT_DROPPED).throw();
    }

    // - class to_string -
    if ($TcpServer != "TcpServer")
    {
      new Exception("TcpServer to_string: expected TcpServer, got %s" % $TcpServer).throw();
    }

    if ($TcpConn != "TcpConn")
    {
      new Exception("TcpConn to_string: expected TcpConn, got %s" % $TcpConn).throw();
    }

    if ($TcpClient != "TcpClient")
    {
      new Exception("TcpClient to_string: expected TcpClient, got %s" % $TcpClient).throw();
    }
  }/*}}}*/
}
