
import mqtt;

class Main
{
  static public main(argv)
  {/*{{{*/

    // - event constants -
    expected = [
      "EVENT_ERROR",MqttClient.EVENT_ERROR,1,
      "EVENT_CONNECTED",MqttClient.EVENT_CONNECTED,2,
      "EVENT_DISCONNECTED",MqttClient.EVENT_DISCONNECTED,3,
      "EVENT_DROPPED",MqttClient.EVENT_DROPPED,4,
      "EVENT_PUBLISHED",MqttClient.EVENT_PUBLISHED,5,
      "EVENT_SUBSCRIBED",MqttClient.EVENT_SUBSCRIBED,6,
      "EVENT_UNSUBSCRIBED",MqttClient.EVENT_UNSUBSCRIBED,7,
      "EVENT_RECEIVED",MqttClient.EVENT_RECEIVED,8,
      "EVENT_PINGRESP",MqttClient.EVENT_PINGRESP,9,

      // - property identifiers (mqtt v5 table 2-4) -
      "PROP_PAYLOAD_FORMAT_INDICATOR",MqttClient.PROP_PAYLOAD_FORMAT_INDICATOR,0x01,
      "PROP_MESSAGE_EXPIRY_INTERVAL",MqttClient.PROP_MESSAGE_EXPIRY_INTERVAL,0x02,
      "PROP_CONTENT_TYPE",MqttClient.PROP_CONTENT_TYPE,0x03,
      "PROP_RESPONSE_TOPIC",MqttClient.PROP_RESPONSE_TOPIC,0x08,
      "PROP_CORRELATION_DATA",MqttClient.PROP_CORRELATION_DATA,0x09,
      "PROP_SUBSCRIPTION_IDENTIFIER",MqttClient.PROP_SUBSCRIPTION_IDENTIFIER,0x0b,
      "PROP_SESSION_EXPIRY_INTERVAL",MqttClient.PROP_SESSION_EXPIRY_INTERVAL,0x11,
      "PROP_ASSIGNED_CLIENT_IDENTIFIER",MqttClient.PROP_ASSIGNED_CLIENT_IDENTIFIER,0x12,
      "PROP_SERVER_KEEP_ALIVE",MqttClient.PROP_SERVER_KEEP_ALIVE,0x13,
      "PROP_AUTHENTICATION_METHOD",MqttClient.PROP_AUTHENTICATION_METHOD,0x15,
      "PROP_AUTHENTICATION_DATA",MqttClient.PROP_AUTHENTICATION_DATA,0x16,
      "PROP_REQUEST_PROBLEM_INFORMATION",MqttClient.PROP_REQUEST_PROBLEM_INFORMATION,0x17,
      "PROP_WILL_DELAY_INTERVAL",MqttClient.PROP_WILL_DELAY_INTERVAL,0x18,
      "PROP_REQUEST_RESPONSE_INFORMATION",MqttClient.PROP_REQUEST_RESPONSE_INFORMATION,0x19,
      "PROP_RESPONSE_INFORMATION",MqttClient.PROP_RESPONSE_INFORMATION,0x1a,
      "PROP_SERVER_REFERENCE",MqttClient.PROP_SERVER_REFERENCE,0x1c,
      "PROP_REASON_STRING",MqttClient.PROP_REASON_STRING,0x1f,
      "PROP_RECEIVE_MAXIMUM",MqttClient.PROP_RECEIVE_MAXIMUM,0x21,
      "PROP_TOPIC_ALIAS_MAXIMUM",MqttClient.PROP_TOPIC_ALIAS_MAXIMUM,0x22,
      "PROP_TOPIC_ALIAS",MqttClient.PROP_TOPIC_ALIAS,0x23,
      "PROP_MAXIMUM_QOS",MqttClient.PROP_MAXIMUM_QOS,0x24,
      "PROP_RETAIN_AVAILABLE",MqttClient.PROP_RETAIN_AVAILABLE,0x25,
      "PROP_USER_PROPERTY",MqttClient.PROP_USER_PROPERTY,0x26,
      "PROP_MAXIMUM_PACKET_SIZE",MqttClient.PROP_MAXIMUM_PACKET_SIZE,0x27,
      "PROP_WILDCARD_SUBSCRIPTION_AVAILABLE",MqttClient.PROP_WILDCARD_SUBSCRIPTION_AVAILABLE,0x28,
      "PROP_SUBSCRIPTION_IDENTIFIER_AVAILABLE",MqttClient.PROP_SUBSCRIPTION_IDENTIFIER_AVAILABLE,0x29,
      "PROP_SHARED_SUBSCRIPTION_AVAILABLE",MqttClient.PROP_SHARED_SUBSCRIPTION_AVAILABLE,0x2a,
    ];

    idx = 0;
    while (idx < expected.length())
    {
      if (expected[idx + 1] != expected[idx + 2])
      {
        new Exception("%s: expected %d, got %d" % [expected[idx],expected[idx + 2],expected[idx + 1]]).throw();
      }

      idx += 3;
    }

    // - class to_string -
    if ($MqttClient != "MqttClient")
    {
      new Exception("$MqttClient: expected MqttClient, got %s" % $MqttClient).throw();
    }
  }/*}}}*/
}
