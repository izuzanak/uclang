
import sys;
import lang;
import mqtt;

class Main
{
  static events = [];
  static received = [];
  static published = [];
  static subscribed = 0;
  static disconnected = 0;

  public Main() {}

  public on_event(a_client)
  {/*{{{*/
    ev = a_client.event();
    events.push(ev);

    if (ev == MqttClient.EVENT_RECEIVED)
    {
      received.push([a_client.topic(),a_client.payload()]);
    }
    else if (ev == MqttClient.EVENT_PUBLISHED)
    {
      published.push(a_client.packet_id());
    }
    else if (ev == MqttClient.EVENT_SUBSCRIBED)
    {
      subscribed = 1;
    }
    else if (ev == MqttClient.EVENT_DISCONNECTED)
    {
      disconnected = 1;
    }
  }/*}}}*/

  // - start the stub broker with tls, returns its pipe -
  static start_broker(a_argv,a_port)
  {/*{{{*/
    parts = a_argv[0].split("/");
    parts.last() = "00_broker_helper.ucl";
    helper = parts.to_string("/");
    parts.last() = "test_localhost.cert";
    cert = parts.to_string("/");
    parts.last() = "test_localhost.key";
    key = parts.to_string("/");

    pipe = new Pipe("uclang %s %d %s %s" % [helper,a_port,cert,key],"r");

    // - wait for the ready line, five seconds at most -
    res = new Poll([pipe.get_fd(),Poll.POLLIN]).poll(5000);
    if (Blank == res or pipe.readln() != "ready")
    {
      new Exception("broker did not start").throw();
    }

    return pipe;
  }/*}}}*/

  // - drive the client until the condition holds -
  static pump(a_client,a_condition,a_name)
  {/*{{{*/
    rounds = 0;
    while (rounds < 200 and a_condition.call([]) != 1)
    {
      rounds += 1;

      fds = a_client.get_fds();
      if (fds.length() == 0)
      {
        break;
      }

      res = new Poll(fds).poll(50);
      if (Blank == res)
      {
        continue;
      }

      if (res[0] != 0)
      {
        a_client.process(fds[0],res[0]);
      }
    }

    if (a_condition.call([]) != 1)
    {
      new Exception("timeout waiting for %s, events %s" % [a_name,$events]).throw();
    }
  }/*}}}*/

  static public main(argv)
  {/*{{{*/

    // - ssl methods exist only when built with openssl, other builds skip -
    ssl_available = 1;
    try { Lang.cls("MqttClient").method("init_ssl#0"); }
    catch (e) { ssl_available = 0; }

    if (ssl_available)
    {
      obj = new Main();
      port = 20900 + (Sys.getpid() % 1000);

      broker = start_broker(argv,port);

      // - init_ssl must precede the first process call -
      client = new MqttClient("127.0.0.1",port,"ucl-tls",new Delegate(obj,"on_event",1),new Blank());

      if ($client.init_ssl() != "MqttClient")
      {
        new Exception("init_ssl: expected MqttClient return").throw();
      }

      // - second init_ssl must throw -
      caught = 0;
      try {
        client.init_ssl();
      }
      catch (e)
      {
        caught = 1;
      }
      if (caught != 1)
      {
        new Exception("client init_ssl twice did not throw").throw();
      }

      pump(client,:(){ return events.length() >= 1 ? 1 : 0; },"tls connect");

      if (events != [MqttClient.EVENT_CONNECTED])
      {
        new Exception("tls connect: expected [EVENT_CONNECTED], got %s" % $events).throw();
      }

      client.subscribe(["tls/topic"],"",1);
      pump(client,:(){ return subscribed; },"tls suback");

      // - qos 1 round trip over tls, payload larger than one tls record is not needed -
      pid = client.publish("tls/topic","secret payload","",1,0);
      pump(client,:(){ return (received.length() >= 1 and published.length() >= 1) ? 1 : 0; },"tls round trip");

      if (received != [["tls/topic","secret payload"]])
      {
        new Exception("tls delivery: got %s" % $received).throw();
      }

      if (published != [pid])
      {
        new Exception("tls publish ack: expected [%d], got %s" % [pid,$published]).throw();
      }

      // - graceful disconnect, the broker is told to quit first -
      client.publish("$SYS/quit","","",0,0);
      client.disconnect();
      pump(client,:(){ return disconnected; },"tls disconnect");

      if (client.events() != 0)
      {
        new Exception("events after disconnect: expected 0, got %d" % client.events()).throw();
      }

      client = 0;
      broker.close();
    }
  }/*}}}*/
}
